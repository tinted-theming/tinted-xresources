! base24 Lumina Quartz Light
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #f6f7f8
#define base01 #eff0f2
#define base02 #e3e5e6
#define base03 #d3d4d6
#define base04 #858687
#define base05 #404246
#define base06 #474849
#define base07 #404246
#define base08 #861d1d
#define base09 #9f420b
#define base0A #a16011
#define base0B #207f4f
#define base0C #037393
#define base0D #3566a4
#define base0E #653eae
#define base0F #a7367b
#define base12 #601e1c
#define base13 #874e00
#define base14 #0f693e
#define base15 #005e79
#define base16 #21528e
#define base17 #7e3861

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
