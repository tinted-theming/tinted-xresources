! base24 Lumina Vitrail Light
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #fcfaf4
#define base01 #f6f3eb
#define base02 #eae8df
#define base03 #dad7cf
#define base04 #89867f
#define base05 #0f141d
#define base06 #4a4841
#define base07 #0f141d
#define base08 #752200
#define base09 #4c1f00
#define base0A #7c4700
#define base0B #00490f
#define base0C #005b72
#define base0D #1729b2
#define base0E #49318e
#define base0F #62127e
#define base12 #581700
#define base13 #623700
#define base14 #003408
#define base15 #004659
#define base16 #12247b
#define base17 #480d5e

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
