! base24 Lumina Dusk Light
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #f6f3fe
#define base01 #f0ecfa
#define base02 #e4e0ef
#define base03 #d4d0de
#define base04 #878491
#define base05 #2e2945
#define base06 #494552
#define base07 #2e2945
#define base08 #872423
#define base09 #8c491d
#define base0A #9e611b
#define base0B #357545
#define base0C #007185
#define base0D #3163ad
#define base0E #7b46a4
#define base0F #874d82
#define base12 #622320
#define base13 #854e07
#define base14 #216033
#define base15 #005b6c
#define base16 #2b5088
#define base17 #713a6c

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
