! base24 Lumina Dusk Light
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #f1eaf2
#define base01 #ece2ee
#define base02 #e1d7e2
#define base03 #d0c7d2
#define base04 #877e88
#define base05 #3f3341
#define base06 #4c454e
#define base07 #3f3341
#define base08 #882322
#define base09 #944e20
#define base0A #644c31
#define base0B #27693a
#define base0C #006576
#define base0D #334f9d
#define base0E #5a4d91
#define base0F #6f2c79
#define base12 #622220
#define base13 #593500
#define base14 #125529
#define base15 #00505e
#define base16 #283e7a
#define base17 #532559

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
