! base24 Lumina Canopy Dark
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #0c1b10
#define base01 #0f2014
#define base02 #192a1d
#define base03 #223427
#define base04 #5b6f5f
#define base05 #d8e3d6
#define base06 #a8b5aa
#define base07 #d8e3d6
#define base08 #d57068
#define base09 #f6ae7c
#define base0A #d1cca8
#define base0B #99d0a4
#define base0C #86cfd7
#define base0D #9acaf1
#define base0E #bfb8f3
#define base0F #e2acdd
#define base12 #e1928b
#define base13 #f4e792
#define base14 #b2ebbd
#define base15 #9fe9f1
#define base16 #c0e3ff
#define base17 #fdc5f8

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
