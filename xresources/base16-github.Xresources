! base16 Github
! Scheme author: Tinted Theming (https://github.com/tinted-theming)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #ffffff
#define base01 #f6f8fa
#define base02 #afb8c1
#define base03 #8c959f
#define base04 #6e7781
#define base05 #424a53
#define base06 #32383f
#define base07 #1f2328
#define base08 #953800
#define base09 #0550ae
#define base0A #bf8700
#define base0B #0a3069
#define base0C #116329
#define base0D #8250df
#define base0E #cf222e
#define base0F #82071e

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base05

*color8:       base03
*color9:       base08
*color10:      base0B
*color11:      base0A
*color12:      base0D
*color13:      base0E
*color14:      base0C
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
