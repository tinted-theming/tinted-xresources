#define base00 #edf8ff
#define base01 #e3f2fb
#define base02 #d8e6f0
#define base03 #c8d6df
#define base04 #7b8891
#define base05 #1d2f47
#define base06 #3d4a52
#define base07 #1d2f47
#define base08 #94171b
#define base09 #a14e14
#define base0A #a35f00
#define base0B #1e773b
#define base0C #056271
#define base0D #0160a7
#define base0E #7244a9
#define base0F #8d4487
#define base12 #6c1f1d
#define base13 #874e00
#define base14 #01622a
#define base15 #004d59
#define base16 #004c87
#define base17 #763171

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
