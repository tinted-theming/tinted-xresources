! base24 Helsinki
! Scheme author: xscriptor (https://github.com/xscriptor)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #f8fafe
#define base01 #edeef1
#define base02 #e4e5e7
#define base03 #b0a999
#define base04 #8d8a82
#define base05 #544d40
#define base06 #3b362d
#define base07 #000000
#define base08 #1faa9e
#define base09 #268da6
#define base0A #2e70ad
#define base0B #733d9a
#define base0C #bd4c3d
#define base0D #b55a0f
#define base0E #3e9d21
#define base0F #1b6374
#define base12 #009e91
#define base13 #0f5ba2
#define base14 #5a1f8a
#define base15 #b32e1f
#define base16 #b23b00
#define base17 #218c00

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
