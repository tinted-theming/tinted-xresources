! base24 Lumina Dusk Dark
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #1a1825
#define base01 #1f1c2b
#define base02 #282635
#define base03 #323040
#define base04 #6d697d
#define base05 #e0dcea
#define base06 #b1afbc
#define base07 #e0dcea
#define base08 #d0746c
#define base09 #f5b284
#define base0A #efcb7b
#define base0B #a0d1a9
#define base0C #90cfd7
#define base0D #9bbef2
#define base0E #c1bbf0
#define base0F #e1b0dc
#define base12 #de958d
#define base13 #ffe5ad
#define base14 #b9ecc2
#define base15 #a9e9f2
#define base16 #bdd8ff
#define base17 #fcc9f7

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
