#define base00 #200b0a
#define base01 #2f1b1b
#define base02 #3a2727
#define base03 #525053
#define base04 #968a91
#define base05 #f7f1ff
#define base06 #f9f4ff
#define base07 #f7f1ff
#define base08 #fc618d
#define base09 #fea78b
#define base0A #ffed89
#define base0B #7bd88f
#define base0C #47e6ff
#define base0D #47e6ff
#define base0E #ff9999
#define base0F #b0705e
#define base12 #fc618d
#define base13 #ffed89
#define base14 #7bd88f
#define base15 #47e6ff
#define base16 #47e6ff
#define base17 #ff9999

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
