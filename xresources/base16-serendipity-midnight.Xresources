! base16 Serendipity Midnight
! Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #151726
#define base01 #1c1e2d
#define base02 #1c1e2d
#define base03 #6b6d7c
#define base04 #8d8f9e
#define base05 #dee0ef
#define base06 #dee0ef
#define base07 #151726
#define base08 #ee8679
#define base09 #ee8679
#define base0A #a78bfa
#define base0B #5ba2d0
#define base0C #f8d2c9
#define base0D #94b8ff
#define base0E #a78bfa
#define base0F #5ba2d0

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base05

*color8:       base03
*color9:       base08
*color10:      base0B
*color11:      base0A
*color12:      base0D
*color13:      base0E
*color14:      base0C
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
