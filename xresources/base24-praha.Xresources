#define base00 #1a1a1a
#define base01 #2a2a2a
#define base02 #353535
#define base03 #6272a4
#define base04 #989898
#define base05 #ffffff
#define base06 #ffffff
#define base07 #ffffff
#define base08 #ff5555
#define base09 #ff9c7c
#define base0A #ffe4a3
#define base0B #b8e6a0
#define base0C #8be9fd
#define base0D #bd93f9
#define base0E #ff9aa2
#define base0F #af6e5a
#define base12 #ff6e6e
#define base13 #ffe4a3
#define base14 #b8e6a0
#define base15 #a4ffff
#define base16 #d6acff
#define base17 #ff9aa2

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
