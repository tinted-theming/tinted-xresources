! base24 Lichen Chartreuse Dark
! Scheme author: Aaron Colichia (https://aaron.colichia.org/)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #151613
#define base01 #1c1e1a
#define base02 #3e5123
#define base03 #899282
#define base04 #a0a598
#define base05 #e0e5da
#define base06 #ecefe7
#define base07 #fcfcfa
#define base08 #e28b82
#define base09 #d5ad73
#define base0A #b2d084
#define base0B #83bda5
#define base0C #9cc6c9
#define base0D #78adc4
#define base0E #bfa6d4
#define base0F #d2a0b2
#define base12 #e28b82
#define base13 #d5ad73
#define base14 #cfe4ae
#define base15 #97c9c9
#define base16 #a3b8c2
#define base17 #d2a0b2

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
