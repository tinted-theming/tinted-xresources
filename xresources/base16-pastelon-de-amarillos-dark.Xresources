! base16 Pastelón de Amarillos Dark
! Scheme author: Richard Martinez (https://sonofmartinus.com)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #180d18
#define base01 #2a1424
#define base02 #432031
#define base03 #a0747c
#define base04 #c39a89
#define base05 #ffe0a3
#define base06 #ffebc5
#define base07 #fff7e6
#define base08 #ff646a
#define base09 #f99a32
#define base0A #ffc84a
#define base0B #3ccb83
#define base0C #35c4b6
#define base0D #5a9fe6
#define base0E #d978cf
#define base0F #e2764a

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base05

*color8:       base03
*color9:       base08
*color10:      base0B
*color11:      base0A
*color12:      base0D
*color13:      base0E
*color14:      base0C
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
