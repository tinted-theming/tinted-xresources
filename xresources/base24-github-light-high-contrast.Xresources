! base24 Github Light High Contrast
! Scheme author: Tinted Theming (https://github.com/tinted-theming)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #ffffff
#define base01 #e7ecf0
#define base02 #acb6c0
#define base03 #88929d
#define base04 #66707b
#define base05 #343b43
#define base06 #20252c
#define base07 #0e1116
#define base08 #702c00
#define base09 #023b95
#define base0A #956400
#define base0B #032563
#define base0C #024c1a
#define base0D #622cbc
#define base0E #a0111f
#define base0F #6e011a
#define base12 #ee5a5d
#define base13 #b58407
#define base14 #26a148
#define base15 #49bcb7
#define base16 #368cf9
#define base17 #a371f7

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
