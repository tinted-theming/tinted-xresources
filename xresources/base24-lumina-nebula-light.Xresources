! base24 Lumina Nebula Light
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #f6f8fb
#define base01 #eff1f6
#define base02 #e3e6ea
#define base03 #d3d5da
#define base04 #84868a
#define base05 #1f2a38
#define base06 #46484b
#define base07 #1f2a38
#define base08 #902725
#define base09 #944d1f
#define base0A #996000
#define base0B #2e7241
#define base0C #00657e
#define base0D #34639e
#define base0E #6c4d9e
#define base0F #84487f
#define base12 #692623
#define base13 #7e4e00
#define base14 #1a5d2f
#define base15 #005064
#define base16 #214f88
#define base17 #6e3569

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
