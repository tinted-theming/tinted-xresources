#define base00 #0e1410
#define base01 #16211a
#define base02 #1e3023
#define base03 #5c6e5e
#define base04 #96aa98
#define base05 #cfe5d2
#define base06 #daebda
#define base07 #e4f0e2
#define base08 #e2706a
#define base09 #7dc97a
