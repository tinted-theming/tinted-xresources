#define base00 #161826
#define base01 #1a1c2c
#define base02 #242636
#define base03 #2d3041
#define base04 #666b7e
#define base05 #dde1ec
#define base06 #aeb0be
#define base07 #dde1ec
#define base08 #d57068
#define base09 #fab17e
#define base0A #f3c085
#define base0B #8fdcba
#define base0C #88d2da
#define base0D #c6d6e8
#define base0E #b0a4f8
#define base0F #e5aedf
#define base12 #e2928a
#define base13 #ffdfba
#define base14 #b0f5d5
#define base15 #a1ecf5
#define base16 #d8eaff
#define base17 #ffc8f9

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
