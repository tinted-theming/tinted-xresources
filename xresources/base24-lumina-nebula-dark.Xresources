! base24 Lumina Nebula Dark
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #0a111a
#define base01 #0e1520
#define base02 #171f29
#define base03 #202833
#define base04 #606a77
#define base05 #cadceb
#define base06 #abb2bb
#define base07 #cadceb
#define base08 #d36059
#define base09 #ddc6b0
#define base0A #f7cf55
#define base0B #8bce99
#define base0C #00dfe5
#define base0D #92bef8
#define base0E #aaaaec
#define base0F #e3a2dc
#define base12 #df847d
#define base13 #ffe6a0
#define base14 #a3e9b2
#define base15 #8ff1f4
#define base16 #bad7ff
#define base17 #ffbbf7

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
