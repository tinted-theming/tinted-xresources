! base24 Github Light Colorblind
! Scheme author: Tinted Theming (https://github.com/tinted-theming)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #ffffff
#define base01 #f6f8fa
#define base02 #d1d9e0
#define base03 #818b98
#define base04 #59636e
#define base05 #454c54
#define base06 #25292e
#define base07 #1f2328
#define base08 #bc4c00
#define base09 #953800
#define base0A #9a6700
#define base0B #0550ae
#define base0C #1b7c83
#define base0D #0969da
#define base0E #8250df
#define base0F #953800
#define base12 #953800
#define base13 #633c01
#define base14 #0969da
#define base15 #3192aa
#define base16 #218bff
#define base17 #a475f9

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
