! base24 Lumina Vitrail Dark
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #070912
#define base01 #0a0d17
#define base02 #131621
#define base03 #1c1f2b
#define base04 #646876
#define base05 #f1eee6
#define base06 #aeb1ba
#define base07 #f1eee6
#define base08 #ff763b
#define base09 #ff9e56
#define base0A #fbca3f
#define base0B #76d983
#define base0C #4de0f7
#define base0D #7299ff
#define base0E #b8acff
#define base0F #d19cdf
#define base12 #ffa37f
#define base13 #ffe6a7
#define base14 #93f39f
#define base15 #abf2ff
#define base16 #97b6ff
#define base17 #efb2ff

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
