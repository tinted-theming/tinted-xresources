#define base00 #042930
#define base01 #042e36
#define base02 #103941
#define base03 #1c434b
#define base04 #547c86
#define base05 #d7e6e7
#define base06 #9db6bc
#define base07 #d7e6e7
#define base08 #d3726a
#define base09 #f9b283
#define base0A #e7cf94
#define base0B #9fd4a9
#define base0C #5ad3d6
#define base0D #8ec3f9
#define base0E #c8baf6
#define base0F #e5b0df
