! base24 Lumina Quartz Dark
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #161719
#define base01 #1a1c1e
#define base02 #242527
#define base03 #2e2f31
#define base04 #676a6d
#define base05 #ccd0d3
#define base06 #b0b1b3
#define base07 #ccd0d3
#define base08 #c57c74
#define base09 #f6be9a
#define base0A #dfcfb0
#define base0B #9dd7b7
#define base0C #a8d5db
#define base0D #b6ceed
#define base0E #cbb4ef
#define base0F #e4bddf
#define base12 #d59a93
#define base13 #ffe5b1
#define base14 #c2edd5
#define base15 #c1eff6
#define base16 #d6e8ff
#define base17 #ffd7fa

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
