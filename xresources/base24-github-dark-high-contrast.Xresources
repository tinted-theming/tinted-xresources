! base24 Github Dark High Contrast
! Scheme author: Tinted Theming (https://github.com/tinted-theming)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #0a0c10
#define base01 #272b33
#define base02 #7a828e
#define base03 #9ea7b3
#define base04 #bdc4cc
#define base05 #f0f3f6
#define base06 #ffffff
#define base07 #ffffff
#define base08 #ffb757
#define base09 #91cbff
#define base0A #e09b13
#define base0B #addcff
#define base0C #72f088
#define base0D #dbb7ff
#define base0E #ff9492
#define base0F #ffb1af
#define base12 #ff9492
#define base13 #f0b72f
#define base14 #26cd4d
#define base15 #33b3ae
#define base16 #71b7ff
#define base17 #cb9eff

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
