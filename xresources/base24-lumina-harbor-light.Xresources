! base24 Lumina Harbor Light
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #fbf5ec
#define base01 #f6eee1
#define base02 #ebe2d6
#define base03 #dad2c6
#define base04 #8d857a
#define base05 #1c2d4f
#define base06 #4d473c
#define base07 #1c2d4f
#define base08 #8c1c1d
#define base09 #9f501d
#define base0A #a25f06
#define base0B #19784d
#define base0C #046871
#define base0D #0468a4
#define base0E #6758a8
#define base0F #8b499a
#define base12 #651f1d
#define base13 #874e00
#define base14 #00623c
#define base15 #00535a
#define base16 #005486
#define base17 #713b7d

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
