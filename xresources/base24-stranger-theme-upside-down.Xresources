! base24 Stranger Theme Upside Down
! Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #0d1117
#define base01 #21252b
#define base02 #2a3c4a
#define base03 #7a8495
#define base04 #c8c8c2
#define base05 #f8f8f2
#define base06 #fffffe
#define base07 #ffffff
#define base08 #e06c75
#define base09 #d19a66
#define base0A #e5c07b
#define base0B #98c379
#define base0C #56b6c2
#define base0D #61afef
#define base0E #c678dd
#define base0F #a9723e
#define base12 #fe8a93
#define base13 #ffde99
#define base14 #b6e197
#define base15 #74d4e0
#define base16 #7fcdff
#define base17 #e496fb

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
