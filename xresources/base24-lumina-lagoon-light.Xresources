! base24 Lumina Lagoon Light
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #e9fafa
#define base01 #e1f4f4
#define base02 #d5e8e8
#define base03 #c5d8d8
#define base04 #758b8b
#define base05 #0b323b
#define base06 #384c4c
#define base07 #0b323b
#define base08 #8f2121
#define base09 #924918
#define base0A #a1600d
#define base0B #2e6147
#define base0C #006e71
#define base0D #185ca9
#define base0E #7153b5
#define base0F #894984
#define base12 #682220
#define base13 #874e00
#define base14 #005031
#define base15 #00585b
#define base16 #154986
#define base17 #72366e

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
