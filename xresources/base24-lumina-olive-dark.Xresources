#define base00 #212311
#define base01 #262814
#define base02 #30321d
#define base03 #3a3c27
#define base04 #6f755c
#define base05 #dfddce
#define base06 #b1b3a3
#define base07 #dfddce
#define base08 #cd6f71
#define base09 #e18c5f
