! base24 Lumina Olive Dark
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #1a1b0c
#define base01 #1f200f
#define base02 #282918
#define base03 #323422
#define base04 #6a6e58
#define base05 #e1dfce
#define base06 #b1b2a5
#define base07 #e1dfce
#define base08 #d3726a
#define base09 #ffc39b
#define base0A #ebc27c
#define base0B #b5d5c6
#define base0C #8bcfd7
#define base0D #a2c4f0
#define base0E #c0baf2
#define base0F #d5a2d0
#define base12 #e0938c
#define base13 #ffdea7
#define base14 #b5f7da
#define base15 #a3e9f2
#define base16 #c4ddff
#define base17 #f0bbeb

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
