! base24 Lumina Aurora Light
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #f7f6fb
#define base01 #f0eff6
#define base02 #e5e3ea
#define base03 #d4d3da
#define base04 #86858b
#define base05 #302a3b
#define base06 #48474c
#define base07 #302a3b
#define base08 #860e23
#define base09 #a04f19
#define base0A #9b6400
#define base0B #006d3c
#define base0C #006d80
#define base0D #2765b0
#define base0E #524663
#define base0F #9a4580
#define base12 #5f171e
#define base13 #815200
#define base14 #00572e
#define base15 #005867
#define base16 #165196
#define base17 #803569

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
