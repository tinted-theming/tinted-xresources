#define base00 #f9f4f5
#define base01 #f4edee
#define base02 #e8e1e3
#define base03 #d8d1d2
#define base04 #8a8486
#define base05 #4f3c45
#define base06 #4c4647
#define base07 #4f3c45
#define base08 #982e24
#define base09 #9c5324
#define base0A #9f6202
#define base0B #287849
#define base0C #3d606e
#define base0D #35659f
#define base0E #724399
#define base0F #864a81
#define base12 #712c24
#define base13 #845000
#define base14 #166338
#define base15 #004f66
#define base16 #215189
#define base17 #70376b

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
