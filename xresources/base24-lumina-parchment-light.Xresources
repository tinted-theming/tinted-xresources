! base24 Lumina Parchment Light
! Scheme author: Razik Ikhlef (https://github.com/RazikSF)
! Template author: Tinted Theming (https://github.com/tinted-theming)

#define base00 #f3e9d2
#define base01 #e9e3d5
#define base02 #ddd7c9
#define base03 #cdc7b9
#define base04 #8c7f63
#define base05 #302416
#define base06 #52462b
#define base07 #302416
#define base08 #811d1d
#define base09 #9c5224
#define base0A #905c00
#define base0B #1b4732
#define base0C #006476
#define base0D #2b5a94
#define base0E #594c92
#define base0F #832f6f
#define base12 #5c1d1b
#define base13 #764a00
#define base14 #003520
#define base15 #004f5e
#define base16 #17467e
#define base17 #642955

*foreground:   base05
#ifdef background_opacity
*background:   [background_opacity]base00
#else
*background:   base00
#endif
*cursorColor:  base05

*color0:       base00
*color1:       base08
*color2:       base0B
*color3:       base0A
*color4:       base0D
*color5:       base0E
*color6:       base0C
*color7:       base06

*color8:       base03
*color9:       base12
*color10:      base14
*color11:      base13
*color12:      base16
*color13:      base17
*color14:      base15
*color15:      base07

! Note: colors beyond 15 might not be loaded (e.g., xterm, urxvt),
! use 'shell' template to set these if necessary
*color16:      base09
*color17:      base0F
*color18:      base01
*color19:      base02
*color20:      base04
*color21:      base06
